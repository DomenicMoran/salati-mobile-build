  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "List of Connecting Letters (Harf al-'Atf)",
      "entries": [
        {
          "beschreibung": "and, connects two elements",
          "beispiel": "Indeed, Allah and His angels send blessings upon the Prophet."
        },
        {
          "beschreibung": "or",
          "beispiel": "So they are like stones, or harder."
        },
        {
          "beschreibung": "and then (longer duration)",
          "beispiel": "How can you disbelieve in Allah, seeing that you were dead and He gave you life; then He will cause you to die, then bring you back to life again."
        },
        {
          "beschreibung": "and then/immediately",
          "beispiel": "Then He shaped you and proportioned you."
        },
        {
          "beschreibung": "rather/instead",
          "beispiel": "And they said: Allah has taken a son. Glory be to Him! Rather, to Him belongs whatever is in the heavens."
        },
        {
          "beschreibung": "however",
          "beispiel": "Yet the wrongdoers today are in manifest error."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "Istifham (Interrogative Particles) with Examples from the Qur'an",
      "entries": [
        {
          "beschreibung": "Is/Are",
          "beispiel": "Do you know better, or does Allah?"
        },
        {
          "beschreibung": "Is/Are",
          "beispiel": "Do you have any certain knowledge?"
        },
        {
          "beschreibung": "What",
          "beispiel": "And what is that in your right hand, O Musa?"
        },
        {
          "beschreibung": "Who",
          "beispiel": "Who is stronger than us in might?"
        },
        {
          "beschreibung": "When",
          "beispiel": "When will this promise come to pass?"
        },
        {
          "beschreibung": "When",
          "beispiel": "When is the Day of Judgment?"
        },
        {
          "beschreibung": "How",
          "beispiel": "How do you give life to the dead?"
        },
        {
          "beschreibung": "Where",
          "beispiel": "Where are those you regarded as partners?"
        },
        {
          "beschreibung": "How",
          "beispiel": "How could he have authority over us?"
        },
        {
          "beschreibung": "From where",
          "beispiel": "O Maryam, from where do you have this?"
        },
        {
          "beschreibung": "How many",
          "beispiel": "How long have you remained?"
        },
        {
          "beschreibung": "Which",
          "beispiel": "Which of the two groups is better in position?"
        }
      ]
    }
