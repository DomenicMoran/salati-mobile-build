  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "Liste des lettres de liaison (Harf al-'Atf)",
      "entries": [
        {
          "beschreibung": "et, relie deux éléments",
          "beispiel": "En vérité, Allah et Ses anges envoient des bénédictions sur le Prophète."
        },
        {
          "beschreibung": "ou",
          "beispiel": "Ils sont ainsi comme des pierres, ou plus durs encore."
        },
        {
          "beschreibung": "et ensuite (durée plus longue)",
          "beispiel": "Comment pouvez-vous renier Allah, alors que vous étiez morts et qu'Il vous a fait vivre ; puis Il vous fera mourir, puis Il vous fera revivre."
        },
        {
          "beschreibung": "et aussitôt",
          "beispiel": "Puis Il t'a façonné et t'a mis en parfait ordre."
        },
        {
          "beschreibung": "plutôt/au contraire",
          "beispiel": "Et ils dirent : Allah S'est attribué un fils. Gloire à Lui ! Il possède plutôt tout ce qui est dans les cieux."
        },
        {
          "beschreibung": "cependant",
          "beispiel": "Mais aujourd'hui, les injustes sont dans un égarement évident."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "Istifham (particules interrogatives) avec exemples tirés du Coran",
      "entries": [
        {
          "beschreibung": "Est/Sont",
          "beispiel": "Est-ce vous qui savez mieux, ou Allah ?"
        },
        {
          "beschreibung": "Est/Sont",
          "beispiel": "Avez-vous quelque connaissance certaine ?"
        },
        {
          "beschreibung": "Que, quoi",
          "beispiel": "Et qu'est-ce que cela dans ta main droite, ô Musa ?"
        },
        {
          "beschreibung": "Qui",
          "beispiel": "Qui est plus fort que nous en puissance ?"
        },
        {
          "beschreibung": "Quand",
          "beispiel": "Quand cette promesse se réalisera-t-elle ?"
        },
        {
          "beschreibung": "Quand",
          "beispiel": "Quand sera le Jour du Jugement ?"
        },
        {
          "beschreibung": "Comment",
          "beispiel": "Comment redonnes-Tu la vie aux morts ?"
        },
        {
          "beschreibung": "Où",
          "beispiel": "Où sont ceux que vous considériez comme associés ?"
        },
        {
          "beschreibung": "Comment",
          "beispiel": "Comment pourrait-il avoir un pouvoir sur nous ?"
        },
        {
          "beschreibung": "D'où",
          "beispiel": "Ô Maryam, d'où te vient cela ?"
        },
        {
          "beschreibung": "Combien",
          "beispiel": "Combien de temps êtes-vous restés ?"
        },
        {
          "beschreibung": "Lequel",
          "beispiel": "Laquelle des deux factions est la meilleure quant à sa position ?"
        }
      ]
    }
  },
