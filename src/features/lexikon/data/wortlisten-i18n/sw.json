  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "Orodha ya Herufi za Kuunganisha (Harf al-'Atf)",
      "entries": [
        {
          "beschreibung": "na, huunganisha vipengele viwili",
          "beispiel": "Hakika, Allah na Malaika Wake wanamswalia Nabii."
        },
        {
          "beschreibung": "au",
          "beispiel": "Basi wao ni kama mawe au wagumu zaidi."
        },
        {
          "beschreibung": "kisha (muda mrefu zaidi)",
          "beispiel": "Mnawezaje kumkanusha Allah, na hali mlikuwa wafu naye akawahuisha, kisha atawafisha, kisha atawahuisha tena."
        },
        {
          "beschreibung": "kisha/mara moja",
          "beispiel": "Kisha akakuumba sawasawa na kukulinganisha."
        },
        {
          "beschreibung": "bali/badala yake",
          "beispiel": "Na walisema: Allah amejifanyia mwana. Ametakasika (Subhanahu)! Bali ni Vyake vyote vilivyomo mbinguni."
        },
        {
          "beschreibung": "lakini",
          "beispiel": "Lakini madhalimu leo wamo katika upotovu ulio dhahiri."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "Istifham (Vipashio vya Kuuliza) pamoja na Mifano kutoka Qur'ani",
      "entries": [
        {
          "beschreibung": "Je",
          "beispiel": "Je, mnajua zaidi ninyi au Allah?"
        },
        {
          "beschreibung": "Je",
          "beispiel": "Je, mna ujuzi wowote wa uhakika?"
        },
        {
          "beschreibung": "Nini",
          "beispiel": "Na nini hicho kilicho mkononi mwako wa kulia, ewe Musa?"
        },
        {
          "beschreibung": "Nani",
          "beispiel": "Ni nani mwenye nguvu zaidi kuliko sisi?"
        },
        {
          "beschreibung": "Lini",
          "beispiel": "Ahadi hii itatimia lini?"
        },
        {
          "beschreibung": "Lini",
          "beispiel": "Siku ya Hukumu ni lini?"
        },
        {
          "beschreibung": "Vipi",
          "beispiel": "Unawahuishaje wafu?"
        },
        {
          "beschreibung": "Wapi",
          "beispiel": "Wako wapi wale mliokuwa mkiwashirikisha?"
        },
        {
          "beschreibung": "Vipi",
          "beispiel": "Atawezaje kuwa na mamlaka juu yetu?"
        },
        {
          "beschreibung": "Kutoka wapi",
          "beispiel": "Ewe Maryam, umepata hili kutoka wapi?"
        },
        {
          "beschreibung": "Ngapi",
          "beispiel": "Mlikaa muda gani?"
        },
        {
          "beschreibung": "Gani",
          "beispiel": "Ni ipi kati ya makundi mawili iliyo bora zaidi katika hali yake?"
        }
      ]
    }
  },
