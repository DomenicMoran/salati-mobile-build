  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "فهرست حروف عطف (Huruf al-ʿAtf)",
      "entries": [
        {
          "beschreibung": "و، دو عنصر را به هم پیوند می‌دهد",
          "beispiel": "به‌راستی، الله و فرشتگانش بر پیامبر درود می‌فرستند."
        },
        {
          "beschreibung": "یا",
          "beispiel": "پس آنان مانند سنگ‌اند یا سخت‌تر."
        },
        {
          "beschreibung": "سپس (با فاصلهٔ زمانی بیشتر)",
          "beispiel": "چگونه به الله کافر می‌شوید، حال آنکه مرده بودید و او شما را زنده کرد؟ سپس شما را می‌میراند، سپس دوباره زنده می‌کند."
        },
        {
          "beschreibung": "پس، بی‌درنگ",
          "beispiel": "پس تو را ساخت و درست‌اندام کرد."
        },
        {
          "beschreibung": "بلکه",
          "beispiel": "و گفتند: الله فرزندی گرفته است. منزّه است او! بلکه آنچه در آسمان‌هاست از آنِ اوست."
        },
        {
          "beschreibung": "اما، ولی",
          "beispiel": "اما ستمگران امروز در گمراهی آشکارند."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "استفهام (ادات پرسش) با نمونه‌هایی از قرآن",
      "entries": [
        {
          "beschreibung": "آیا",
          "beispiel": "آیا شما داناترید یا الله؟"
        },
        {
          "beschreibung": "آیا",
          "beispiel": "آیا هیچ دانش قطعی‌ای دارید؟"
        },
        {
          "beschreibung": "چه",
          "beispiel": "و آن چیست در دست راست تو، ای موسی؟"
        },
        {
          "beschreibung": "چه کسی",
          "beispiel": "چه کسی از ما نیرومندتر است؟"
        },
        {
          "beschreibung": "کِی",
          "beispiel": "این وعده کِی فرا می‌رسد؟"
        },
        {
          "beschreibung": "کِی",
          "beispiel": "روز جزا کِی است؟"
        },
        {
          "beschreibung": "چگونه",
          "beispiel": "چگونه مردگان را زنده می‌کنی؟"
        },
        {
          "beschreibung": "کجا",
          "beispiel": "کجایند کسانی‌که آن‌ها را شریک می‌پنداشتید؟"
        },
        {
          "beschreibung": "چگونه",
          "beispiel": "چگونه او را بر ما فرمانروایی باشد؟"
        },
        {
          "beschreibung": "از کجا",
          "beispiel": "ای مریم، این از کجا برای توست؟"
        },
        {
          "beschreibung": "چند، چه‌مدت",
          "beispiel": "چه‌مدت درنگ کردید؟"
        },
        {
          "beschreibung": "کدام",
          "beispiel": "کدام‌یک از این دو گروه جایگاهش بهتر است؟"
        }
      ]
    }
  },
