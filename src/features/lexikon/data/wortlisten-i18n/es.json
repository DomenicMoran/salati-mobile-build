  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "Lista de las letras de conexión (Harf al-'Atf)",
      "entries": [
        {
          "beschreibung": "y, une dos elementos",
          "beispiel": "En verdad, Allah y Sus ángeles envían bendiciones sobre el Profeta."
        },
        {
          "beschreibung": "o",
          "beispiel": "Así son como piedras, o aún más duros."
        },
        {
          "beschreibung": "y luego (mayor duración)",
          "beispiel": "¿Cómo podéis negar a Allah, si estabais muertos y Él os dio vida? Luego os hará morir y después os volverá a dar vida."
        },
        {
          "beschreibung": "y luego/de inmediato",
          "beispiel": "Luego te formó y te dio una figura armoniosa."
        },
        {
          "beschreibung": "más bien/en cambio",
          "beispiel": "Y dijeron: Allah ha tomado un hijo. ¡Gloria a Él! Más bien, Suyo es cuanto hay en los cielos."
        },
        {
          "beschreibung": "sin embargo",
          "beispiel": "Sin embargo, hoy los injustos están en un extravío evidente."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "Istifham (partícula interrogativa) con ejemplos del Corán",
      "entries": [
        {
          "beschreibung": "Es/Son",
          "beispiel": "¿Lo sabéis vosotros mejor, o Allah?"
        },
        {
          "beschreibung": "Es/Son",
          "beispiel": "¿Tenéis acaso un conocimiento cierto?"
        },
        {
          "beschreibung": "Qué",
          "beispiel": "¿Y qué es eso que tienes en tu mano derecha, oh Musa?"
        },
        {
          "beschreibung": "Quién",
          "beispiel": "¿Quién es más fuerte que nosotros en poder?"
        },
        {
          "beschreibung": "Cuándo",
          "beispiel": "¿Cuándo se cumplirá esta promesa?"
        },
        {
          "beschreibung": "Cuándo",
          "beispiel": "¿Cuándo será el Día del Juicio?"
        },
        {
          "beschreibung": "Cómo",
          "beispiel": "¿Cómo das vida a los muertos?"
        },
        {
          "beschreibung": "Dónde",
          "beispiel": "¿Dónde están aquellos que considerabais copartícipes?"
        },
        {
          "beschreibung": "Cómo",
          "beispiel": "¿Cómo podría él tener dominio sobre nosotros?"
        },
        {
          "beschreibung": "De dónde",
          "beispiel": "Oh Maryam, ¿de dónde tienes esto?"
        },
        {
          "beschreibung": "Cuántos",
          "beispiel": "¿Cuánto tiempo habéis permanecido?"
        },
        {
          "beschreibung": "Cuál",
          "beispiel": "¿Cuál de los dos grupos es mejor en su posición?"
        }
      ]
    }
  },
