  "beispielsatzlisten": {
    "beispielsatzliste-h55-verbindungsbuchstaben": {
      "title": "قائمة حروف العطف",
      "entries": [
        {
          "beschreibung": "الواو، تربط بين عنصرين",
          "beispiel": "إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ."
        },
        {
          "beschreibung": "أو",
          "beispiel": "فَهِيَ كَالْحِجَارَةِ أَوْ أَشَدُّ قَسْوَةً."
        },
        {
          "beschreibung": "ثم، وتفيد التراخي (مدة أطول)",
          "beispiel": "كَيْفَ تَكْفُرُونَ بِاللَّهِ وَكُنتُمْ أَمْوَاتًا فَأَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ."
        },
        {
          "beschreibung": "الفاء، وتفيد الترتيب والتعقيب مباشرة",
          "beispiel": "فَسَوَّاكَ فَعَدَلَكَ."
        },
        {
          "beschreibung": "بل، للإضراب",
          "beispiel": "وَقَالُوا اتَّخَذَ اللَّهُ وَلَدًا سُبْحَانَهُ بَلْ لَهُ مَا فِي السَّمَاوَاتِ."
        },
        {
          "beschreibung": "لكن",
          "beispiel": "لَٰكِنِ الظَّالِمُونَ الْيَوْمَ فِي ضَلَالٍ مُّبِينٍ."
        }
      ]
    },
    "beispielsatzliste-h166-istifham-partikel": {
      "title": "أدوات الاستفهام مع أمثلة من القرآن",
      "entries": [
        {
          "beschreibung": "هل / أ",
          "beispiel": "أَأَنتُمْ أَعْلَمُ أَمِ اللَّهُ؟"
        },
        {
          "beschreibung": "هل / أ",
          "beispiel": "هَلْ عِندَكُم مِّنْ عِلْمٍ؟"
        },
        {
          "beschreibung": "ما",
          "beispiel": "وَمَا تِلْكَ بِيَمِينِكَ يَا مُوسَىٰ؟"
        },
        {
          "beschreibung": "مَن",
          "beispiel": "مَنْ أَشَدُّ مِنَّا قُوَّةً؟"
        },
        {
          "beschreibung": "متى",
          "beispiel": "مَتَىٰ هَٰذَا الْوَعْدُ؟"
        },
        {
          "beschreibung": "متى",
          "beispiel": "أَيَّانَ يَوْمُ الدِّينِ؟"
        },
        {
          "beschreibung": "كيف",
          "beispiel": "كَيْفَ تُحْيِي الْمَوْتَىٰ؟"
        },
        {
          "beschreibung": "أين",
          "beispiel": "أَيْنَ شُرَكَائِيَ الَّذِينَ كُنتُمْ تَزْعُمُونَ؟"
        },
        {
          "beschreibung": "كيف / أنّى",
          "beispiel": "أَنَّىٰ يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا؟"
        },
        {
          "beschreibung": "أنّى",
          "beispiel": "يَا مَرْيَمُ أَنَّىٰ لَكِ هَٰذَا؟"
        },
        {
          "beschreibung": "كم",
          "beispiel": "كَمْ لَبِثْتُمْ؟"
        },
        {
          "beschreibung": "أيّ",
          "beispiel": "أَيُّ الْفَرِيقَيْنِ خَيْرٌ مَّقَامًا؟"
        }
      ]
    }
