diff --git a/apple/Sources/ExpoModulesJSI-Cxx/include/RuntimeScheduler.h b/apple/Sources/ExpoModulesJSI-Cxx/include/RuntimeScheduler.h
--- a/apple/Sources/ExpoModulesJSI-Cxx/include/RuntimeScheduler.h
+++ b/apple/Sources/ExpoModulesJSI-Cxx/include/RuntimeScheduler.h
@@ -5,6 +5,26 @@
 #include <atomic>
 #include <swift/bridging>
 
+// PATCH (Salati, 2026-08-25): das SWIFT_SHARED_REFERENCE-Attribut nach VORN.
+//
+// Xcode 26.1/26.2/26.3 weisen die Datei sonst ab:
+//   'RuntimeScheduler' cannot be annotated with either SWIFT_RETURNS_RETAINED
+//   or SWIFT_RETURNS_UNRETAINED because it is not returning a
+//   SWIFT_SHARED_REFERENCE type
+//
+// Die Konstruktoren tragen SWIFT_RETURNS_RETAINED, das Attribut
+// SWIFT_SHARED_REFERENCE stand aber erst an der SCHLIESSENDEN Klammer der
+// Klasse. Neuere Clang-Staende pruefen die Konstruktoren, bevor sie dort
+// ankommen - und kennen die Klasse zu dem Zeitpunkt noch nicht als geteilte
+// Referenz. Das Attribut gehoert deshalb an den Klassenkopf; dafuer muessen
+// die beiden Funktionen vorher deklariert sein.
+namespace expo {
+class RuntimeScheduler;
+} // namespace expo
+
+void retainRuntimeScheduler(expo::RuntimeScheduler *scheduler);
+void releaseRuntimeScheduler(expo::RuntimeScheduler *scheduler);
+
 namespace expo {
 
 /**
@@ -18,7 +38,7 @@
  Priority values mirror facebook::react::SchedulerPriority — kept here as a
  plain enum so we don't include the React header.
  */
-class RuntimeScheduler {
+class SWIFT_SHARED_REFERENCE(retainRuntimeScheduler, releaseRuntimeScheduler) RuntimeScheduler {
 public:
   enum class Priority : int {
     ImmediatePriority = 1,
@@ -87,7 +107,7 @@
       delete this;
     }
   }
-} SWIFT_SHARED_REFERENCE(retainRuntimeScheduler, releaseRuntimeScheduler);
+};
 
 } // namespace expo
 
